{
  "name": "@bitlogin/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "BitLogin protocol core: crypto, capsules, Nostr relay I/O, account flows. Framework- and DOM-free.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./crypto": "./dist/crypto/index.js",
    "./nostr": "./dist/nostr/index.js",
    "./capsules": "./dist/capsules/index.js",
    "./account": "./dist/account/index.js",
    "./storage": "./dist/storage/index.js",
    "./vault": "./dist/vault/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/bip39": "2.2.0",
    "canonicalize": "3.0.0",
    "diceware-wordlist-en-eff": "1.0.1",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
