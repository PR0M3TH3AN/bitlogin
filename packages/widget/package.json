{
  "name": "@bitlogin/widget",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "BitLogin embeddable login widget: a <bitlogin-auth> custom element plus a window.nostr NIP-07-compatible provider, backed by a dedicated crypto Web Worker.",
  "main": "./dist/bitlogin.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./dist/bitlogin.js"
    },
    "./session": {
      "types": "./dist-types/session.d.ts",
      "default": "./dist/bitlogin-session.js"
    },
    "./headless": {
      "types": "./dist-types/headless.d.ts",
      "default": "./dist/bitlogin-headless.js"
    }
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitlogin/core": "*",
    "@getalby/bitcoin-connect": "3.12.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
